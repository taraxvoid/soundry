---
import Base from '../layouts/Base.astro'
---

<Base
  title="For Funders — Soundry"
  description="Soundry program overview and leadership for grant reviewers and prospective partners."
>
  <section class="section hero-section" id="grants-hero">
    <div class="section-inner">
      <h1>For Funders</h1>
      <p>
        Program overview and leadership for grant reviewers and prospective
        partners.
      </p>
    </div>
  </section>

  <section class="section grants-section" id="program">
    <div class="section-inner">
      <h2>Program</h2>
      <p>
        Soundry is a 501(c)(3) experimental music education program in
        Omaha, Nebraska. Since 2018 it has run public workshops, open to all
        ages, in soundscaping, instrument building, deep listening, and DIY
        music technology. Workshops are currently hosted at the Church/Art
        House in South Omaha; see the <a href="/events">events listing</a> for
        the current schedule.
      </p>
    </div>
  </section>

  <section class="section grants-section grants-section--alt" id="leadership">
    <div class="section-inner">
      <h2>Leadership</h2>
      <h3>Dr. Stacey Barelos, founder</h3>
      <p>
        Stacey Barelos is a sound artist, composer, performer, and educator.
        She holds a DMA from the University of Wisconsin–Madison and teaches
        music theory at the University of Nebraska at Omaha. A certified
        Deep Listening facilitator since 2021, she leads workshops and
        residencies across the U.S. and internationally, most recently at
        the Ex Nihilo Festival in Guanajuato, Mexico, and the University of
        Nebraska–Kearney New Music Festival.
      </p>
      <p>
        Her work has been supported by a 2023 Bemis Community Arts Grant and
        a 2024 Fortuna Grant, and was featured on Nebraska Public
        Media's <em>What If</em>. Full bio at <a
          href="https://staceybarelos.com/about/"
          target="_blank"
          rel="noopener noreferrer"
        >staceybarelos.com</a>.
      </p>
    </div>
  </section>

  <section class="section grants-section" id="contact">
    <div class="section-inner">
      <h2>Contact</h2>
      <p>
        For grant inquiries or program documentation, message <a
          href="https://www.instagram.com/omahasoundry/"
          target="_blank"
          rel="noopener noreferrer"
        >@omahasoundry</a> on Instagram. Participants
        can <a href="/#story">share their own story</a> on the home page.
      </p>
    </div>
  </section>
</Base>

<style>
  .grants-section {
    background: var(--white);
  }
  .grants-section--alt {
    background: var(--cream);
  }
  .grants-section h2 {
    font-size: 1.75rem;
    color: var(--primary-dark);
    margin: 0 0 1rem;
  }
  .grants-section h3 {
    font-size: 1.2rem;
    color: var(--dark);
    margin: 0 0 0.75rem;
  }
  .grants-section p {
    line-height: 1.6;
    max-width: 720px;
    margin: 0 0 1rem;
  }
  .grants-section p:last-child {
    margin-bottom: 0;
  }
</style>
