---
const host = Astro.site?.host ?? 'soundryomaha.org'
const webcalUrl = `webcal://${host}/events.ics`
const googleCalendarUrl = `https://calendar.google.com/calendar/r?cid=${encodeURIComponent(webcalUrl)}`
---

<div class="calendar-subscribe">
  <a
    href={googleCalendarUrl}
    target="_blank"
    rel="noopener noreferrer"
    class="btn-calendar"
  >
    <wa-icon name="calendar" aria-hidden="true"></wa-icon> Subscribe to Calendar
  </a>
</div>
