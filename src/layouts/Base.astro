---
import '@fontsource/bevan'
import '@fontsource/atkinson-hyperlegible/400.css'
import '@fontsource/atkinson-hyperlegible/700.css'
import '../styles/theme.css'
import Logo from '../components/Logo.astro'
import { keyColorClass } from '../utils/keyColors'

interface Props {
    title?: string
    description?: string
}

const {
    title = "Soundry — Omaha's Experimental Music Education Workshops",
    description = 'Soundry activates the local Omaha community to enrich their creative practice with experimental education workshops.',
} = Astro.props

const year = new Date().getFullYear()

const navLinks = [
    { href: '#events', label: 'Events' },
    { href: '#signup', label: 'Signup' },
    { href: '#donate', label: 'Donate' },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="alternate" type="text/calendar" href="/events.ics" title="Soundry Events" />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon-180x180.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#6e3226" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>

    <!-- Navigation -->
    <header class="site-header">
      <div class="nav-inner">
        <a href="/" class="nav-logo"><Logo /></a>
        <ul class="nav-links">
          {navLinks.map((link, index) => (
            <li><a href={link.href} class:list={['nav-key', keyColorClass(index)]}>{link.label}</a></li>
          ))}
          <li>
            <a
              href="https://www.instagram.com/omahasoundry/"
              target="_blank"
              rel="noopener noreferrer"
              aria-label="Instagram"
              class:list={['nav-key', 'nav-instagram', keyColorClass(navLinks.length)]}
            ><wa-icon name="instagram" family="brands"></wa-icon></a>
          </li>
        </ul>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer>
      <p>© {year} Soundry. All rights reserved.</p>
      <p>
        built with
        <wa-icon
          name="heart"
          style="font-size: 0.9rem; color: var(--primary-light); display: inline;"
        ></wa-icon>
        by 
        <a
          href="https://www.ravenflight.io"
          target="_blank"
          rel="noopener noreferrer"
        >
          ravenflight
        </a>
      </p>
    </footer>

    <script>
      import '@awesome.me/webawesome/dist/components/icon/icon.js'
      import '@awesome.me/webawesome/dist/components/card/card.js'
    </script>

    <button id="backToTop" aria-label="Back to top">
      <wa-icon name="circle-arrow-up" variant="solid"></wa-icon>
    </button>

    <script>
      // Back to top
      const backToTop = document.getElementById('backToTop')
      const header = document.querySelector('.site-header')
      if (backToTop && header) {
        window.addEventListener('scroll', () => {
          backToTop.classList.toggle('show', window.scrollY > header.clientHeight)
        })
        backToTop.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: 'smooth' })
        })
      }
    </script>
  </body>
</html>
